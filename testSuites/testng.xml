<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests">
<listeners>
<listener class-name="testComponents.Listeners"></listener>
</listeners>
  <test thread-count="5" name="Standalone">
    <classes>
      <class name="seleniumTests.StandaloneCase"/>
    </classes>
  </test> <!-- Test -->
   
   <test thread-count="5" name="Error Validations">
    <classes>
      <class name="seleniumTests.ErrorValidations"/>
    </classes>
  </test>
</suite> <!-- Suite -->
